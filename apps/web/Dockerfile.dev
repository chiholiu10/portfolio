FROM node:22-alpine
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1 PORT_MANAGED_BY_DOCKER=true
EXPOSE 3100
CMD ["sh", "-c", "yarn install --frozen-lockfile --non-interactive --ignore-scripts && MATCHER_API_URL=http://matcher-api:8000 MATCHER_API_TOKEN=local-development-only yarn workspace @portfolio/web dev"]
