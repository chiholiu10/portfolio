{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx kill-port 3001 && next dev -p 3001",
    "docker": "docker compose up --build",
    "docker:prune": "docker system prune -a -f",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify": "yarn lint && yarn typecheck && yarn test --runInBand && yarn build",
    "reinstall": "rm -rf node_modules yarn.lock package-lock.json && yarn install",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "index:career-knowledge": "node scripts/index-career-knowledge.mjs",
    "ci": "yarn install --frozen-lockfile --non-interactive",
    "test": "jest",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "graphql": "16.9.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intersection-observer": "^9.5.2",
    "styled-components": "^6.1.15",
    "zod": "^4.3.6",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^18.7.18",
    "@types/react": "^19.2.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.4",
    "jest": "^29.1.0",
    "typescript": "^5.7.3",
    "@eslint/js": "^9.20.0",
    "globals": "^15.14.0",
    "@types/react-dom": "^19.2.0",
    "@types/jest": "^29.5.0",
    "lint-staged": "^16.2.0",
    "eslint-import-resolver-typescript": "^3.10.0"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 115",
      "Safari >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
