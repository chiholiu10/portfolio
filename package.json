{
  "name": "chiho-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "dev:docker": "node scripts/dev.mjs --docker",
    "dev:web": "yarn workspace @portfolio/web dev",
    "dev:python": "node scripts/dev-python.mjs",
    "dev:stop": "docker compose stop web matcher-api",
    "prod:build": "node scripts/production.mjs build",
    "prod:up": "node scripts/production.mjs up",
    "prod:up:detached": "node scripts/production.mjs up-detached",
    "prod:check": "node scripts/check-production.mjs",
    "prod:logs": "node scripts/production.mjs logs",
    "prod:down": "node scripts/production.mjs down",
    "build": "yarn format:check && yarn workspace @portfolio/web build",
    "start": "yarn workspace @portfolio/web start",
    "typecheck": "yarn workspace @portfolio/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn workspace @portfolio/web test",
    "test:python": "apps/matcher-api/.venv/bin/python -m unittest discover -s apps/matcher-api -p \"test_*.py\"",
    "test:format": "node --test scripts/prettier-styles-plugin.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn format:check && yarn test:format && yarn lint && yarn typecheck && yarn test --runInBand && yarn test:python && yarn eval:matcher:check && yarn build",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "ci": "yarn install --frozen-lockfile --non-interactive",
    "reinstall": "rm -rf node_modules && yarn install --frozen-lockfile",
    "index:career-knowledge": "node scripts/index-career-knowledge.mjs",
    "setup:python": "python3 -m venv apps/matcher-api/.venv && apps/matcher-api/.venv/bin/pip install -r apps/matcher-api/requirements-test.txt",
    "test:docker": "node scripts/test-matcher-docker.mjs",
    "eval:matcher": "apps/matcher-api/.venv/bin/python scripts/evaluate-matcher.py",
    "eval:matcher:check": "apps/matcher-api/.venv/bin/python scripts/evaluate-matcher.py --check",
    "eval:matcher:live": "node scripts/evaluate-matcher-live.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.20.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.7.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.10.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.4",
    "jest": "^29.1.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{mjs,cjs,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
