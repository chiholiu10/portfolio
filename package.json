{
  "name": "chiho-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "yarn workspace @portfolio/web dev",
    "dev:python": "python3 apps/matcher-api/server.py",
    "dev:stop": "docker compose stop web matcher-api",
    "build": "yarn format:check && yarn workspace @portfolio/web build",
    "start": "yarn workspace @portfolio/web start",
    "typecheck": "yarn workspace @portfolio/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn workspace @portfolio/web test",
    "test:python": "python3 -m unittest discover -s apps/matcher-api -p \"test_*.py\"",
    "test:format": "node --test scripts/prettier-styles-plugin.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn format:check && yarn test:format && yarn lint && yarn typecheck && yarn test --runInBand && yarn test:python && yarn build",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "ci": "yarn install --frozen-lockfile --non-interactive",
    "reinstall": "rm -rf node_modules && yarn install --frozen-lockfile",
    "index:career-knowledge": "node scripts/index-career-knowledge.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.20.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.7.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.10.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.4",
    "jest": "^29.1.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{mjs,cjs,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
